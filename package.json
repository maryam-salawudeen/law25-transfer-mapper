{
  "name": "law25-transfer-mapper",
  "version": "0.1.0",
  "description": "Map the personal information a website sends outside Québec and draft the Law 25 transfer privacy impact assessment.",
  "type": "module",
  "bin": {
    "law25-map": "dist/cli.js"
  },
  "files": [
    "dist",
    "data"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "map": "node --import tsx src/cli.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "playwright": "^1.64.1",
    "tldts": "^7.4.19"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
